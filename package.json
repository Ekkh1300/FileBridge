{
  "name": "filebridge",
  "version": "0.1.0",
  "private": true,
  "description": "Fast LAN transfer of files, text and clipboard between your phone and PC.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm install",
    "build": "npm run build -w client",
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "npm run server",
    "server": "npm run start -w server",
    "server:dev": "npm run dev -w server",
    "client:dev": "npm run dev -w client",
    "exe": "node tools/make-ico.mjs && node tools/build-exe.mjs",
    "installer": "& \"C:\\Program Files\\Inno Setup 7\\ISCC.exe\" installer\\filebridge.iss",
    "tailscale": "node tools/tailscale-info.mjs"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.21.5"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "pkg": {
    "assets": [
      "client/dist/**/*"
    ]
  }
}
